<div class="page-header">
    <div class="page-title">My Courses 📚</div>
</div>
@if (Model != null && Model.Any())
{
<div class="courses-grid">

    @foreach (var item in Model)
    {
        <div class="course-card">

            <img src="@item.imageURL" class="course-img" />

            <div class="course-body">

                <div class="course-title">
                    @item.Title
                </div>

                <div class="course-meta">
                    <span class="badge-level">@item.Level</span>
                    <span>@item.Language</span>
                </div>

                <div class="course-meta">
                    <span>@item.Category</span>

                    @if (item.isFree == "Free")
                    {
                        <span class="price free">Free</span>
                    }
                    else
                    {
                        <span class="price paid">@item.Price EGP</span>
                    }
                </div>

            </div>

                <div class="course-action">
                    @if (User.IsInRole("Instructor"))
                    {
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-CourseId="@item.CourseId" class="btn-view flex-grow-1 text-center text-decoration-none">Manage</a>

                            <form asp-action="deleteCourse" method="post" onsubmit="return confirm('Are you sure?')">
                                <input type="hidden" name="CourseId" value="@item.CourseId" />
                                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <a asp-action="Details" asp-route-CourseId="@item.CourseId" class="btn-view text-center text-decoration-none">View Details</a>
                    }
                </div>

        </div>
    }

</div>
}
else
{
    <div class="text-center mt-5 p-5" style="background: #F8FAFC; border-radius: 16px; border: 2px dashed #E2E8F0;">
        <div class="mb-3" style="font-size: 3rem;">📭</div>
        <h5 class="text-dark fw-bold">No courses found yet</h5>
        <p class="text-muted">You haven't added or enrolled in any courses yet. 🚀</p>

        @if (User.IsInRole("Instructor"))
        {
            <a asp-action="createCourse" asp-controller="Course" class="btn-view text-decoration-none px-4">Create Your First Course</a>
        }
    </div>
}
