@using LMS.BLL.ModelVM;

@{
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
}
@model CourseVM

@{
	ViewData["Title"] = "View Details";
}
@{
    bool isEnrolled = ViewBag.IsEnrolled is bool enrolled && enrolled;
    bool isStudent = User.IsInRole("Student");
}
<style>

    .details-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #E2E8F0;
        padding: 1.8rem;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        max-width: 950px;
        margin: auto;
    }

    .course-img {
        width: 100%;
        max-height: 320px;
        object-fit: cover;
        border-radius: 12px;
        margin-bottom: 1rem;
    }

    .course-title {
        font-size: 1.7rem;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 0.4rem;
    }

    .course-desc {
        color: var(--text-muted);
        margin-bottom: 1rem;
    }

    .course-meta {
        display: flex;
        gap: 0.7rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }

    .meta-box {
        background: #F1F5F9;
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
        font-size: 0.8rem;
        color: #334155;
    }

    .price-free {
        color: #16A34A;
    }

    .price-paid {
        color: #DC2626;
    }

    .lessons-section {
        margin-top: 2rem;
    }

    .lessons-title {
        font-weight: 600;
        color: var(--text-dark);
        margin-bottom: 1rem;
    }

    .lesson-card {
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        padding: 0.8rem 1rem;
        border-radius: 10px;
        margin-bottom: 0.6rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .lesson-title {
        font-size: 0.9rem;
        color: var(--text-dark);
        font-weight: 500;
    }

    .btn-primary-custom {
        background: #2563EB;
        color: white;
        border: none;
        padding: 0.4rem 0.8rem;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 500;
        transition: 0.3s;
        margin-right: 5px;
    }

        .btn-primary-custom:hover {
            background: #1D4ED8;
        }

    .btn-danger-custom {
        background: #E11D48;
        color: white;
        border: none;
        padding: 0.4rem 0.8rem;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 500;
        transition: 0.3s;
    }

        .btn-danger-custom:hover {
            background: #BE123C;
        }

    .btn-block {
        width: 100%;
        margin-top: 1rem;
    }

</style>

<div class="details-card">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="custom-alert">
            <i class="fa-solid fa-circle-check"></i>
            @TempData["SuccessMessage"]
        </div>
    }

    <img src="@Model.imageURL" class="course-img" />

    <div class="course-title">@Model.Title</div>
    <div class="course-desc">@Model.Description</div>

    <div class="course-meta">
        <div class="meta-box">@Model.Category</div>
        <div class="meta-box">@Model.Level</div>
        <div class="meta-box">@Model.Language</div>

        @if (Model.isFree == "Free")
        {
            <div class="meta-box price-free">Free</div>
        }
        else
        {
            <div class="meta-box price-paid">@Model.Price $</div>
        }
    </div>

    <div class="lessons-section">
        <div class="lessons-title">📚 Lessons</div>

        @if (Model.Lessons != null && Model.Lessons.Any())
        {
            foreach (var item in Model.Lessons)
            {
                <div class="lesson-card">
                    <div class="lesson-title">@item.Title</div>
                </div>
            }
        }
        else
        {
            <div style="color: var(--text-muted);">No lessons added yet</div>
        }
    </div>
    <div class="mt-4">
        @if (User.IsInRole("Student"))
        {
            if (isEnrolled)
            {
                <div class="alert alert-success text-center border-0 rounded-3 shadow-sm">
                    <i class="fa-solid fa-circle-check me-1"></i>
                    You are already enrolled! Happy learning.
                </div>
            }
            else
            {
                <form method="post" asp-action="enrollCourse" asp-controller="Course">
                    <input type="hidden" name="CourseId" value="@Model.CourseId" />
                    <button type="submit" class="btn-primary-custom btn-block" style="background-color: #16A34A; padding: 0.8rem; font-size: 1rem;">
                        <i class="fa-solid fa-cart-plus me-1"></i>
                        Enroll Now
                    </button>
                </form>
            }
        }
    </div>

</div>