@using LMS.BLL.ModelVM;
@model CourseVM

@{
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
}

@{
    ViewData["Title"] = "Course Details";
}

<style>

    .details-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #E2E8F0;
        padding: 1.8rem;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        max-width: 950px;
        margin: auto;
    }

    .course-img {
        width: 100%;
        max-height: 320px;
        object-fit: cover;
        border-radius: 12px;
        margin-bottom: 1rem;
    }

    .course-title {
        font-size: 1.7rem;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 0.4rem;
    }

    .course-desc {
        color: var(--text-muted);
        margin-bottom: 1rem;
    }

    .course-meta {
        display: flex;
        gap: 0.7rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }

    .meta-box {
        background: #F1F5F9;
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
        font-size: 0.8rem;
        color: #334155;
    }

    .price-free {
        color: #16A34A;
    }

    .price-paid {
        color: #DC2626;
    }

    .lessons-section {
        margin-top: 2rem;
    }

    .lessons-title {
        font-weight: 600;
        color: var(--text-dark);
        margin-bottom: 1rem;
    }

    .lesson-card {
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        padding: 0.8rem 1rem;
        border-radius: 10px;
        margin-bottom: 0.6rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .lesson-title {
        font-size: 0.9rem;
        color: var(--text-dark);
        font-weight: 500;
    }

    .btn-primary-custom {
        background: #2563EB;
        color: white;
        border: none;
        padding: 0.4rem 0.8rem;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 500;
        transition: 0.3s;
        margin-right: 5px;
    }

        .btn-primary-custom:hover {
            background: #1D4ED8;
        }

    .btn-danger-custom {
        background: #E11D48;
        color: white;
        border: none;
        padding: 0.4rem 0.8rem;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 500;
        transition: 0.3s;
    }

        .btn-danger-custom:hover {
            background: #BE123C;
        }

    .btn-block {
        width: 100%;
        margin-top: 1rem;
    }

    .custom-alert {
        margin-bottom: 1.2rem;
        background: #ECFDF5;
        border: 1px solid #A7F3D0;
        color: #065F46;
        padding: 0.8rem 1rem;
        border-radius: 10px;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
        animation: fadeIn 0.4s ease-in-out;
    }

        .custom-alert i {
            color: #10B981;
        }


</style>

<div class="details-card">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="custom-alert">
            <i class="fa-solid fa-circle-check"></i>
            @TempData["SuccessMessage"]
        </div>
    }

    <img src="@Model.imageURL" class="course-img" />

    <div class="course-title">@Model.Title</div>
    <div class="course-desc">@Model.Description</div>

    <div class="course-meta">
        <div class="meta-box">@Model.Category</div>
        <div class="meta-box">@Model.Level</div>
        <div class="meta-box">@Model.Language</div>

        @if (Model.isFree == "Free")
        {
            <div class="meta-box price-free">Free</div>
        }
        else
        {
            <div class="meta-box price-paid">@Model.Price $</div>
        }
    </div>

    <div class="lessons-section">
        <div class="lessons-title">📚 Lessons</div>

        @if (Model.Lessons != null && Model.Lessons.Any())
        {
            foreach (var item in Model.Lessons)
            {
                <div class="lesson-card">

                    <div class="lesson-title">
                        @item.Title
                    </div>

                    <div style="display:flex; gap:5px;">

                        <form method="post" asp-action="editLesson" asp-controller="Lesson">
                            <input type="hidden" name="LessonId" value="@item.LessonId" />
                            <button type="submit" class="btn-primary-custom">
                                <i class="fa-solid fa-pen"></i>
                            </button>
                        </form>

                        <form method="post" asp-action="deleteLesson" asp-controller="Lesson">
                            <input type="hidden" name="LessonId" value="@item.LessonId" />
                            <input type="hidden" name="CourseId" value="@item.CourseId" />
                            <button type="submit" class="btn-danger-custom">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </form>

                    </div>
                </div>
            }
        }
        else
        {
            <div style="color: var(--text-muted);">No lessons added yet</div>
        }
    </div>

    <div class="mt-4">
        <form method="post" asp-action="createLesson" asp-controller="Lesson">
            <input type="hidden" asp-for="CourseId" />
            <button type="submit" class="btn-primary-custom btn-block">
                <i class="fa-solid fa-plus me-1"></i> Add Lesson
            </button>
        </form>

        <form method="post" asp-action="editCourse" asp-controller="Course">
            <input type="hidden" asp-for="CourseId" />
            <button type="submit" class="btn-primary-custom btn-block" style="background-color: #4F46E5;">
                <i class="fa-solid fa-pen-to-square me-1"></i> Edit Course
            </button>
        </form>

        <form method="post" asp-action="deleteCourse" asp-controller="Course" onsubmit="return confirm('Are you sure you want to delete this entire course?')">
            <input type="hidden" asp-for="CourseId" />
            <button type="submit" class="btn-danger-custom btn-block">
                <i class="fa-solid fa-trash me-1"></i> Delete Course
            </button>
        </form>
    </div>
</div>


</div>