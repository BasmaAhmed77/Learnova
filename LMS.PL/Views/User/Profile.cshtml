@model dynamic
@{
    ViewData["Title"] = "Profile";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 text-center p-4 h-100">
                <div class="card-body">
                    <div class="position-relative d-inline-block mb-3">
                        @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                        {
                            <img src="~/Files/Profiles/@Model.ProfilePicture"
                                 class="rounded-circle img-thumbnail shadow-sm"
                                 style="width: 150px; height: 150px; object-fit: cover;" id="userProfilePic" />
                        }
                        else
                        {
                            <div class="rounded-circle d-flex align-items-center justify-content-center bg-light shadow-sm"
                                 style="width: 150px; height: 150px; border: 2px solid #f8f9fa;">
                                <i class="fas fa-user fa-4x text-muted"></i>
                            </div>
                        }
                        <button class="btn btn-sm btn-primary position-absolute bottom-0 end-0 rounded-circle shadow"
                                data-bs-toggle="modal" data-bs-target="#uploadPhotoModal">
                            <i class="fas fa-camera"></i>
                        </button>
                    </div>

                    <div class="d-flex align-items-center justify-content-center mb-1">
                        <h4 class="fw-bold mb-0">@Model.Fname @Model.Lname</h4>
                        <button class="btn btn-link btn-sm text-muted ms-2 p-0 shadow-none" data-bs-toggle="modal" data-bs-target="#editNameModal">
                            <i class="fas fa-edit fa-xs"></i>
                        </button>
                    </div>
                    <p class="text-muted small">@Model.Email</p>

                    <hr class="my-4" />

                    <div class="text-start">
                        <div class="mb-4">
                            <label class="text-muted d-block small mb-1">Phone Number</label>
                            <div class="d-flex justify-content-between align-items-center">
                                @if (string.IsNullOrWhiteSpace(Model.PhoneNumber))
                                {
                                    <span class="text-muted small italic">Not provided</span>
                                    <button class="btn btn-outline-primary btn-sm py-0 px-3 rounded-pill shadow-none"
                                            data-bs-toggle="modal" data-bs-target="#editPhoneModal">
                                        Set Phone
                                    </button>
                                }
                                else
                                {
                                    <span class="fw-bold">@Model.PhoneNumber</span>
                                    <button class="btn btn-link btn-sm text-decoration-none p-0 text-muted shadow-none"
                                            data-bs-toggle="modal" data-bs-target="#editPhoneModal">
                                        Edit
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            @if (User.IsInRole("Instructor"))
            {
                <div class="card shadow-sm border-0 h-100 mb-4">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom-0">
                        <h5 class="mb-0 fw-bold">Professional Details</h5>
                        <button class="btn btn-outline-primary btn-sm rounded-pill shadow-none" data-bs-toggle="modal" data-bs-target="#editInstructorModal">
                            <i class="fas fa-edit me-1"></i> Edit Info
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label class="text-muted d-block small">Job Title</label>
                                <h6 class="fw-bold">@(string.IsNullOrEmpty(Model.Title) ? "Not set" : Model.Title)</h6>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="text-muted d-block small">Academic Degree</label>
                                <h6 class="fw-bold">@(string.IsNullOrEmpty(Model.AcademicDegree) ? "Not set" : Model.AcademicDegree)</h6>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="text-muted d-block small">Years of Experience</label>
                                <h6 class="fw-bold">@Model.YearsOfExperience Years</h6>
                            </div>
                            <div class="col-12 mb-4">
                                <label class="text-muted d-block small">Biography</label>
                                <p class="text-dark" style="line-height: 1.7;">@(string.IsNullOrEmpty(Model.Bio) ? "No biography added yet." : Model.Bio)</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm border-0 h-100 p-5 text-center bg-light d-flex flex-column justify-content-center align-items-center">
                    <i class="fas fa-graduation-cap fa-4x text-muted mb-3 opacity-50"></i>
                    <h3 class="fw-bold">Learning Hub</h3>
                    <p class="text-muted mb-4">Track your courses and assignments from here.</p>
                    <a asp-action="showAllCourses" asp-controller="Course" class="btn btn-primary px-4 rounded-pill">
                        Explore Courses
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="editNameModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0">
                <h5 class="fw-bold">Update Name</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="UpdateName" asp-controller="User" method="post">
                <div class="modal-body">
                    <div class="row">
                        <div class="col">
                            <label class="small fw-bold text-muted">First Name</label>
                            <input name="fname" value="@Model.Fname" class="form-control" required />
                        </div>
                        <div class="col">
                            <label class="small fw-bold text-muted">Last Name</label>
                            <input name="lname" value="@Model.Lname" class="form-control" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="submit" class="btn btn-primary w-100">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="uploadPhotoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold">Profile Photo</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <form asp-action="UpdateProfilePicture" asp-controller="User" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <input type="file" name="Picture" class="form-control" accept="image/*" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 mb-2">Upload New</button>
                </form>
                @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                {
                    <form asp-action="RemoveProfilePicture" asp-controller="User" method="post">
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100">Remove Photo</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editPhoneModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Phone Number</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form asp-action="UpdatePhoneNumber" method="post" class="mb-3">
                    <input type="text" name="PhoneNumber" class="form-control mb-2" maxlength="11"
                           value="@(Model.PhoneNumber == "Not set yet" ? "" : Model.PhoneNumber)"
                           placeholder="01XXXXXXXXX" required />
                    <button type="submit" class="btn btn-primary w-100">Save Changes</button>

                </form>

                @if (!(string.IsNullOrWhiteSpace(Model.PhoneNumber)|| Model.PhoneNumber == "Not set yet"))
                {
                    <hr class="text-muted opacity-25" />
                    <form asp-action="RemovePhoneNumber" asp-controller="User" method="post">
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100">Remove Phone Number</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@if (User.IsInRole("Instructor"))
{
    <div class="modal fade" id="editInstructorModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-bottom-0">
                    <h5 class="fw-bold">Professional Info</h5>
                    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form asp-action="UpdateTitle" asp-controller="Instructor" method="post" class="mb-3">
                        <div class="form-group">
                            <label class="small fw-bold text-muted">Job Title</label>
                            <div class="input-group mt-1">
                                <input name="Title" value="@Model.Title" class="form-control shadow-none" required />
                                <button type="submit" class="btn btn-primary">Update</button>
                            </div>
                        </div>
                    </form>
                    <form asp-action="UpdateAcademicDegree" asp-controller="Instructor" method="post" class="mb-3">
                        <div class="form-group">
                            <label class="small fw-bold text-muted">Academic Degree</label>
                            <div class="input-group mt-1">
                                <input name="AcademicDegree" value="@Model.AcademicDegree" class="form-control shadow-none" required />
                                <button type="submit" class="btn btn-primary">Update</button>
                            </div>
                        </div>
                    </form>
                    <form asp-action="UpdateExperience" asp-controller="Instructor" method="post" class="mb-3">
                        <div class="form-group">
                            <label class="small fw-bold text-muted">Years of Experience</label>
                            <div class="input-group mt-1">
                                <input name="YearsOfExperience" type="number" min="1" value="@Model.YearsOfExperience" class="form-control shadow-none" required />
                                <button type="submit" class="btn btn-primary">Update</button>
                            </div>
                        </div>
                    </form>
                    <hr />
                    <form asp-action="UpdateBio" asp-controller="Instructor" method="post">
                        <div class="form-group">
                            <label class="small fw-bold text-muted">Biography</label>
                            <textarea name="Bio" class="form-control shadow-none mt-1" rows="3">@Model.Bio</textarea>
                        </div>
                        <div class="text-end mt-2">
                            <button type="submit" class="btn btn-primary px-4">Save Bio</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            @if (TempData["SuccessMessage"] != null)
            {
                        <text>
                        Swal.fire({
                            icon: 'success',
                            title: 'Done',
                            text: '@TempData["SuccessMessage"]',
                            timer: 2000,
                            showConfirmButton: false,
                            toast: true,
                            position: 'top-end'
                        });
                        </text>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                        <text>
                        Swal.fire({
                            icon: 'error',
                            title: 'Oops!',
                            text: '@TempData["ErrorMessage"]'
                        });

                        var errorMsg = "@TempData["ErrorMessage"]".toLowerCase();
                        if (errorMsg.includes("phone")) {
                            new bootstrap.Modal(document.getElementById('editPhoneModal')).show();
                        } else if (errorMsg.includes("experience") || errorMsg.includes("title") || errorMsg.includes("degree")) {
                            var instModal = document.getElementById('editInstructorModal');
                            if (instModal) {
                                new bootstrap.Modal(instModal).show();
                            }
                        } else if (errorMsg.includes("name")) {
                            new bootstrap.Modal(document.getElementById('editNameModal')).show();
                        }
                        </text>
            }
        });
    </script>
}