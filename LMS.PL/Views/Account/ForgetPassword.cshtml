@model string
@{
    Layout = "FinalLayout";
    ViewData["Title"] = "Forget Password";
}

<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-5 col-lg-4">
        <div class="card border-0 shadow-sm" style="border-radius: 20px;">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <h3 class="fw-bold">Forget Password?</h3>
                    <p class="text-muted small">Enter your email to get a reset link</p>
                </div>

                <form asp-action="ForgetPassword" method="post">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Email Address</label>
                        <input name="email" type="email" class="form-control border-0 bg-light p-2" style="border-radius: 10px;" placeholder="example@mail.com" required />
                    </div>
                    <button type="submit" class="btn btn-create-header w-100 py-2 mb-3 shadow-sm fw-bold">
                        Send Reset Link
                    </button>
                </form>

                @if (ViewBag.ResetLink != null)
                {
                    <div class="mt-3 p-3 bg-light border-dashed text-center" style="border: 2px dashed var(--primary-blue); border-radius: 10px;">
                        <p class="small mb-1 fw-bold">Development Reset Link:</p>
                        <a href="@ViewBag.ResetLink" class="text-primary small text-break">Click here to set new password</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>