@model LMS.BLL.ModelVM.User.ResetPasswordVM

@{
    Layout = "FinalLayout";
    ViewData["Title"] = "Reset Password";
}

<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-5 col-lg-4">
        <div class="card border-0 shadow-sm" style="border-radius: 20px; background: #ffffff;">
            <div class="card-body p-5">

                <div class="text-center mb-4">
                    <div class="mb-3" style="display: inline-block; padding: 12px; background: #EFF6FF; border-radius: 50%;">
                        <i class="fa-solid fa-lock-open fa-2x" style="color: var(--primary-blue);"></i>
                    </div>
                    <h3 class="fw-bold" style="color: var(--text-dark);">Reset Password</h3>
                    <p class="text-muted small">Please enter your new secure password</p>
                </div>

                <form asp-action="ResetPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 fw-bold"></div>

                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Token" />

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label small fw-bold text-muted">New Password</label>
                        <div class="password-wrapper">
                            <input asp-for="NewPassword" type="password" id="newPass"
                                   class="form-control border-0 bg-light p-2"
                                   style="border-radius: 10px;" placeholder="••••••••" />
                            <i class="fa-solid fa-eye-slash password-toggle-icon" onclick="togglePassword('newPass', this)"></i>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmNewPassword" class="form-label small fw-bold text-muted">Confirm New Password</label>
                        <div class="password-wrapper">
                            <input asp-for="ConfirmNewPassword" type="password" id="confirmPass"
                                   class="form-control border-0 bg-light p-2"
                                   style="border-radius: 10px;" placeholder="••••••••" />
                            <i class="fa-solid fa-eye-slash password-toggle-icon" onclick="togglePassword('confirmPass', this)"></i>
                        </div>
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-create-header w-100 py-2 mb-3 shadow-sm fw-bold">
                        Update Password
                    </button>
                </form>

                <div class="text-center mt-3 pt-3 border-top">
                    <p class="small text-muted">
                        Remembered it?
                        <a asp-action="Login" class="fw-bold text-decoration-none" style="color: var(--primary-blue);">Back to Sign In</a>
                    </p>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}