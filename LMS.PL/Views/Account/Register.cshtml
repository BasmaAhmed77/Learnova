@model LMS.BLL.ModelVM.User.RegisterVM
@{
    Layout = "FinalLayout";
    ViewData["Title"] = "Create Student Account";
}

@{
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
}

<div class="row justify-content-center align-items-center" style="min-height: 100vh; padding: 3rem 0;">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm" style="border-radius: 20px; background: #ffffff;">
            <div class="card-body p-5">

                <div class="text-center mb-4">
                    <div class="mb-3" style="display: inline-block; padding: 15px; background: #EFF6FF; border-radius: 50%;">
                        <i class="fa-solid fa-user-graduate fa-2x" style="color: var(--primary-blue);"></i>
                    </div>
                    <h3 class="fw-bold" style="color: var(--text-dark);">Join the Academy</h3>
                    <p class="text-muted small">Create your student account to access all courses</p>
                </div>

                <form asp-action="Register" method="post">
                    <div asp-validation-summary="All" class="text-danger small mb-4 fw-bold"></div>

                    <h6 class="text-primary mb-3 fw-bold border-bottom pb-2" style="font-size: 0.8rem; letter-spacing: 1px; text-transform: uppercase;">Personal Details</h6>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Fname" class="form-label small fw-bold text-muted">First Name</label>
                            <input asp-for="Fname" class="form-control border-0 bg-light p-2" style="border-radius: 10px;" placeholder="e.g. Jordan" />
                            <span asp-validation-for="Fname" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Lname" class="form-label small fw-bold text-muted">Last Name</label>
                            <input asp-for="Lname" class="form-control border-0 bg-light p-2" style="border-radius: 10px;" placeholder="e.g. Smith" />
                            <span asp-validation-for="Lname" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="UserName" class="form-label small fw-bold text-muted">Username</label>
                            <input asp-for="UserName" class="form-control border-0 bg-light p-2" style="border-radius: 10px;" placeholder="unique_handle" />
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="DOB" class="form-label small fw-bold text-muted">Birth Date</label>
                            <input asp-for="DOB" type="date" class="form-control border-0 bg-light p-2" style="border-radius: 10px;" />
                            <span asp-validation-for="DOB" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Gender" class="form-label small fw-bold text-muted d-block">Gender</label>
                        <div class="d-flex gap-4 mt-2">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="Gender" value="Male" id="m" checked>
                                <label class="form-check-label small" for="m">Male</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="Gender" value="Female" id="f">
                                <label class="form-check-label small" for="f">Female</label>
                            </div>
                        </div>
                        <span asp-validation-for="Gender" class="text-danger small"></span>
                    </div>

                    <h6 class="text-primary mb-3 mt-4 fw-bold border-bottom pb-2" style="font-size: 0.8rem; letter-spacing: 1px; text-transform: uppercase;">Security</h6>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-bold text-muted">Email Address</label>
                        <input asp-for="Email" class="form-control border-0 bg-light p-2" style="border-radius: 10px;" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label small fw-bold text-muted">Password</label>
                            <div class="password-wrapper">
                                <input asp-for="Password" type="password" id="regPassword" class="form-control border-0 bg-light p-2" style="border-radius: 10px;" placeholder="••••••••" />
                                <i class="fa-solid fa-eye-slash password-toggle-icon" onclick="togglePassword('regPassword', this)"></i>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmPassword" class="form-label small fw-bold text-muted">Confirm</label>
                            <div class="password-wrapper">
                                <input asp-for="ConfirmPassword" type="password" id="regConfirm" class="form-control border-0 bg-light p-2" style="border-radius: 10px;" placeholder="••••••••" />
                                <i class="fa-solid fa-eye-slash password-toggle-icon" onclick="togglePassword('regConfirm', this)"></i>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-create-header w-100 py-3 mt-4 shadow-sm fw-bold">
                        Create Account
                    </button>
                </form>

                <div class="text-center mt-4 pt-2 border-top">
                    <p class="small text-muted">
                        Already part of us?
                        <a asp-action="Login" class="fw-bold text-decoration-none" style="color: var(--primary-blue);">Sign In</a>
                    </p>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}