    color: white;
    padding: 3rem;
    border-radius: 18px;
    margin-bottom: 2.5rem;
    gap: 2rem;
    }

    .hero-text {
    flex: 1;
    }

    .hero h1 {
    font-size: 2.4rem;
    font-weight: 800;
    }

    .hero p {
    opacity: 0.9;
    margin-top: 10px;
    }

    .hero img {
    width: 320px;
    border-radius: 14px;
    }

    .hero-actions {
    margin-top: 1.5rem;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    }

    .btn-primary-white {
    background: white;
    color: #2563EB;
    padding: 0.7rem 1.2rem;
    border-radius: 10px;
    font-weight: 600;
    text-decoration: none;
    }

    .btn-outline-white {
    border: 1px solid white;
    color: white;
    padding: 0.7rem 1.2rem;
    border-radius: 10px;
    font-weight: 600;
    text-decoration: none;
    }

    /* ================= CATEGORY ================= */
    .category-title {
    font-size: 1.6rem;
    font-weight: 900;
    margin: 2.5rem 0 1rem;
    color: #0F172A;
    }

    .courses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.3rem;
    }

    /* ================= COURSE CARD (IMPROVED) ================= */
    .course-card {
    background: white;
    border-radius: 16px;
    border: 1px solid #E2E8F0;
    overflow: hidden;
    transition: 0.3s;
    display: flex;
    flex-direction: column;
    position: relative;
    }

    .course-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 35px rgba(0,0,0,0.08);
    }

    .img-wrapper {
    position: relative;
    height: 160px;
    }

    .course-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    }

    /* badge */
    .badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: #2563EB;
    color: white;
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 700;
    }

    .badge.free {
    background: #16A34A;
    }

    /* ================= BODY ================= */
    .course-body {
    padding: 1rem;
    }

    .course-title {
    font-weight: 900;
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
    color: #0F172A;
    }

    /* instructor improved */
    .instructor {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: #64748B;
    margin-bottom: 0.6rem;
    }

    .avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #2563EB;
    color: white;
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    }

    /* meta pills */
    .meta-row {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 0.6rem;
    }

    .pill {
    font-size: 0.7rem;
    padding: 4px 8px;
    border-radius: 20px;
    background: #F1F5F9;
    color: #475569;
    font-weight: 600;
    }

    /* price */
    .price.free {
    color: #16A34A;
    font-weight: 800;
    }

    .price.paid {
    color: #DC2626;
    font-weight: 800;
    }

    /* button */
    .btn-view {
    display: block;
    text-align: center;
    padding: 0.65rem;
    background: linear-gradient(135deg, #2563EB, #1D4ED8);
    color: white;
    text-decoration: none;
    border-radius: 10px;
    margin: 0.8rem;
    font-size: 0.85rem;
    font-weight: 700;
    transition: 0.3s;
    }

    .btn-view:hover {
    transform: scale(1.02);
    opacity: 0.9;
    }

    /* ================= CTA ================= */
    .instructor-cta {
    margin-top: 3rem;
    background: linear-gradient(135deg, #0F172A, #1E293B);
    color: white;
    padding: 3rem;
    border-radius: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    }

    .btn-cta {
    background: #2563EB;
    padding: 0.9rem 1.5rem;
    border-radius: 12px;
    font-weight: 700;
    text-decoration: none;
    color: white;
    }

</style>
