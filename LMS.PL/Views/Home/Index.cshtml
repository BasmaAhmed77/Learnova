                        <a asp-action="Details"
                           asp-controller="Course"
                           asp-route-CourseId="@item.CourseId"
                           class="btn-view">
                            View Details
                        </a>
                    }

                </div>
            }
        }
        else
        {
            <p style="color:gray;">No courses in this category yet.</p>
