@if (!isInstructor)
{
    <div class="instructor-cta">

        <div>
            <h2>Become an Instructor 🎓</h2>
            <p>Share your knowledge, create courses, and earn money while teaching others.</p>
        </div>

        <a href="@Url.Action("RegisterInstructor","Account")" class="btn-cta">
            Start Teaching
        </a>

    </div>
} *@


