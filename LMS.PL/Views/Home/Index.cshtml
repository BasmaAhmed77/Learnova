@* @using LMS.BLL.ModelVM
@model List<CourseVM>

@{
    ViewData["Title"] = "Home";
    bool isLoggedIn = User.Identity.IsAuthenticated;
    bool isInstructor = User.IsInRole("Instructor");
}

<style>

    /* ================= HERO ================= */
    .hero {
        background: linear-gradient(135deg, #2563EB, #1D4ED8);
        color: white;
        padding: 3.5rem 2rem;
        border-radius: 16px;
        margin-bottom: 2rem;
        text-align: center;
    }

        .hero h1 {
            font-size: 2.3rem;
            font-weight: 800;
        }

        .hero p {
            opacity: 0.9;
            margin-top: 10px;
        }

    .hero-actions {
        margin-top: 1.5rem;
    }

        .hero-actions a {
            display: inline-block;
            margin: 0 8px;
            padding: 0.7rem 1.3rem;
            border-radius: 10px;
            font-weight: 600;
            text-decoration: none;
        }

    .btn-primary-white {
        background: white;
        color: #2563EB;
    }

    .btn-outline-white {
        border: 1px solid white;
        color: white;
    }

    /* ================= SECTION ================= */
    .section-title {
        font-weight: 700;
        margin: 2rem 0 1rem;
        color: var(--text-dark);
    }

    /* ================= COURSES GRID ================= */
    .courses-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1.3rem;
    }

    .course-card {
        background: white;
        border-radius: 14px;
        border: 1px solid #E2E8F0;
        overflow: hidden;
        transition: 0.3s;
        display: flex;
        flex-direction: column;
    }

        .course-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.06);
        }

    .course-img {
        width: 100%;
        height: 150px;
        object-fit: cover;
    }

    .course-body {
        padding: 1rem;
        flex-grow: 1;
    }

    .course-title {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: var(--text-dark);
    }

    .course-meta {
        font-size: 0.8rem;
        color: var(--text-muted);
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.4rem;
    }

    .price.free {
        color: #16A34A;
        font-weight: 600;
    }

    .price.paid {
        color: #DC2626;
        font-weight: 600;
    }

    .course-action {
        padding: 0.8rem;
        border-top: 1px solid #E2E8F0;
    }

    .btn-view {
        width: 100%;
        background: var(--primary-blue);
        color: white;
        padding: 0.5rem;
        border-radius: 8px;
        text-align: center;
        display: block;
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 500;
    }

        .btn-view:hover {
            background: #1D4ED8;
        }

    /* ================= CTA ================= */
    .cta-box {
        margin-top: 3rem;
        background: white;
        padding: 2rem;
        border-radius: 14px;
        text-align: center;
        border: 1px solid #E2E8F0;
    }

        .cta-box h4 {
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .cta-box p {
            color: var(--text-muted);
            margin-bottom: 1rem;
        }

    .btn-cta {
        background: var(--primary-blue);
        color: white;
        padding: 0.7rem 1.4rem;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
    }

        .btn-cta:hover {
            background: #1D4ED8;
        }

</style>

<!-- ================= HERO ================= -->
<div class="hero">
    <h1>Learn Anytime, Anywhere 🚀</h1>
    <p>Upgrade your skills with thousands of online courses</p>

    <div class="hero-actions">
        <a href="@Url.Action("Login","Account")" class="btn-primary-white">
            Sign In
        </a>

        @if (!User.Identity.IsAuthenticated)
        {
            <a href="@Url.Action("Register","Account")" class="btn-outline-white">
                Sign Up
            </a>
        }
    </div>
</div>

<!-- ================= FEATURED COURSES ================= -->
<h4 class="section-title">Featured Courses</h4>

<div class="courses-grid">
     @foreach (var item in Model)
    {
        <div class="course-card">

            <img src="@item.imageURL" class="course-img" />

            <div class="course-body">

                <div class="course-title">
                    @item.Title
                </div>

                <div class="course-meta">
                    <span>@item.Level</span>
                    <span>@item.Language</span>
                </div>
                <div>
                    <span>@item.Instructor.UserAccount.Fname</span>
                    <span>@item.Instructor.UserAccount.Lname</span>
                </div>

                <div class="course-meta">
                    <span>@item.Category</span>

                    @if (item.isFree == "Free")
                    {
                        <span class="price free">Free</span>
                    }
                    else
                    {
                        <span class="price paid">@item.Price EGP</span>
                    }
                </div>

            </div>

            <div class="course-action">
                <a asp-action="Details"
                   asp-controller="Course"
                   asp-route-CourseId="@item.CourseId"
                   class="btn-view">
                    View Details
                </a>
            </div>

        </div>
    }

</div>

<!-- ================= INSTRUCTOR CTA ================= -->
@if (!isInstructor)
{
     <div class="cta-box">
        <h4>Want to share your knowledge? 🎓</h4>
        <p>Become an instructor and start teaching students worldwide</p>

        <a href="@Url.Action("RegisterInstructor","Account")" class="btn-cta">
            Become an Instructor
        </a>
    </div>
} *@




