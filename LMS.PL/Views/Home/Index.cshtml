<!-- ================= COURSES ================= -->
@foreach (var cat in categories)
{
    var coursesInCategory = Model.Where(c => c.Category == cat).ToList();

    if(coursesInCategory.Any())
    {
    <div class="category-title">@cat</div>

    <div class="courses-grid">

        @foreach (var item in coursesInCategory)
        {
            <div class="course-card">

                <div class="img-wrapper">

                    <img src="@item.imageURL" class="course-img" />

                    @if (item.isFree == "Free")
                    {
                        <div class="badge free">FREE</div>
                    }

                </div>

                <div class="course-body">

                    <div class="course-title">
                        @item.Title
                    </div>

                    <!-- Instructor improved -->
                    <div class="instructor">
                        <div class="avatar">
                            @item.Instructor.UserAccount.Fname.Substring(0, 1)
                        </div>
                        <span>
                            @item.Instructor.UserAccount.Fname @item.Instructor.UserAccount.Lname
                        </span>
                    </div>

                    <!-- Meta pills -->
                    <div class="meta-row">
                        <span class="pill">@item.Level</span>
                        <span class="pill">@item.Language</span>
                        <span class="pill">@item.Category</span>
                    </div>

                    <div style="display:flex; justify-content:space-between; font-size:0.85rem;">
                        @if (item.isFree == "Free")
                        {
                            <span class="price free">Free</span>
                        }
                        else
                        {
                            <span class="price paid">@item.Price $</span>
                        }
                    </div>

                </div>

                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-action="Details"
                       asp-controller="Course"
                       asp-route-CourseId="@item.CourseId"
                       class="btn-view">
                        View Details
                    </a>
                }

            </div>
        }

    </div>
    }
}

<!-- ================= CTA ================= -->
@if (!isInstructor)
{
    <div class="instructor-cta">

        <div>
            <h2>Become an Instructor 🎓</h2>
            <p>Share your knowledge and start earning from your courses.</p>
        </div>

        <a href="@Url.Action("RegisterInstructor","Account")" class="btn-cta">
            Start Teaching
        </a>

    </div>
}